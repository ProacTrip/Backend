# =============================================================================
# Copiar este archivo a .env y configurar los valores
# =============================================================================

# Aplicación
APP_NAME=ProacTrip - Backend
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_FRONTEND_URL=http://localhost:3000

# Servidor
SERVER_PORT=8080
SERVER_READ_TIMEOUT=20s
SERVER_WRITE_TIMEOUT=20s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=15s

# =============================================================================
# PostgreSQL (Base de datos principal)
# =============================================================================
DB_IMAGE=postgres:18.3-alpine3.23
DB_USER=proactrip
DB_PASSWORD=1234
DB_HOST=postgres
DB_PORT=5432
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLETIME=30m

# URLs de conexión por dominio (database-per-module)
AUTH_DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/auth_db
REFERENCE_DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/reference_db
USER_DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/user_db
BOOKING_DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/booking_db
PAYMENT_DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/payment_db
SEARCH_DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/search_db
NOTIFICATION_DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/notification_db
AUDIT_DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/audit_db

# =============================================================================
# DragonflyDB / Redis (Cache y EventBus)
# =============================================================================
REDIS_IMAGE=ghcr.io/dragonflydb/dragonfly:v1.37.0
REDIS_HOST=dragonfly
REDIS_PORT=6379
REDIS_PASSWORD=1234
REDIS_MAXMEMORY=1gb
DRAGONFLY_CACHE_MODE=true
REDIS_THREADS=2

CACHE_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0
CACHE_POOL_SIZE=10

EVENTBUS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1
EVENTBUS_POOL_SIZE=50
EVENTBUS_MAX_LEN=10000  
EVENTBUS_BLOCK_TIME=10s

AUTH_STREAM_NAME=proactrip:auth:events
AUTH_GROUP_NAME=auth_workers

USER_STREAM_NAME=proactrip:user:events
USER_GROUP_NAME=user_workers

NOTIFICATION_STREAM_NAME=proactrip:notification:events
NOTIFICATION_GROUP_NAME=notification_workers

