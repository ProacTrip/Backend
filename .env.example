# =============================================================================
# ProacTrip Backend - MVP Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# DO NOT commit .env to version control.
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION (Echo v5)
# =============================================================================
SERVER_PORT=8080
SERVER_ENV=dev  # dev | prod

# =============================================================================
# FRONTEND URLS (Separate dev and prod for CORS)
# =============================================================================
FRONTEND_URL_DEV=http://localhost:3000
FRONTEND_URL_PROD=https://proactrip.com

# =============================================================================
# DEFAULT USER PREFERENCES (fallback when geoip fails or is unavailable)
# =============================================================================
DEFAULT_CURRENCY=EUR
DEFAULT_LANGUAGE=es
DEFAULT_COUNTRY_CODE=ES

# =============================================================================
# DRAGONFLYDB CONFIGURATION (v1.38+)
# =============================================================================
DRAGONFLY_HOST=dragonfly
DRAGONFLY_PORT=6379
DRAGONFLY_PASSWORD=proactrip123

# Dragonfly specific settings
DRAGONFLY_THREADS=4
DRAGONFLY_CACHE_MODE=true
DRAGONFLY_MAXMEMORY=512mb

# =============================================================================
# POSTGRESQL CONFIGURATION (PostgreSQL 18.3)
# =============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=proactrip
DB_PASSWORD=proactrip123
DB_NAME=proactrip
DB_SSLMODE=disable

# Image for compose
DB_IMAGE=postgres:18.3

# Generate with: openssl rand -hex 32
PASETO_KEY=YOUR_64_CHAR_HEX_KEY_HERE
# Get from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SerpApi
SERPAPI_KEY=8dxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rate Limit
RATELIMIT_GLOBAL_PER_MINUTE=100
RATELIMIT_AUTH_PER_MINUTE=10
RATELIMIT_ADMIN_PER_MINUTE=30
RATELIMIT_ANON_PER_MINUTE=5
RATELIMIT_PROVIDER_RESEND_MAX=100
RATELIMIT_PROVIDER_RESEND_WINDOW_SEC=86400
RATELIMIT_PROVIDER_SERPAPI_MAX=50
RATELIMIT_PROVIDER_SERPAPI_WINDOW_SEC=3600
# AI rate limit overrides
RATELIMIT_PROVIDER_AI_MAX=10
RATELIMIT_PROVIDER_AI_WINDOW_SEC=3600

# OpenWeather (One Call API 3.0 — 1000 calls/day free)
OPENWEATHER_API_KEY=
OPENWEATHER_TIMEOUT=10s
RATELIMIT_PROVIDER_OPENWEATHER_MAX=1000
RATELIMIT_PROVIDER_OPENWEATHER_WINDOW_SEC=86400	#OpenWeather window (24h)
# TTL de caché para datos de clima (el provider refresca cada ~10min,
# pero el backend cachea agresivamente — el frontend controla la frecuencia)
ENVIRONMENT_WEATHER_CACHE_TTL=30m

# Google
GOOGLE_CLIENT_ID=91.......................................
GOOGLE_CLIENT_SECRET=GO...................................
GOOGLE_REDIRECT_URL=http://localhost:8080/v1/auth/oauth/google/callback

# =============================================================================
# AI SEARCH — Natural Language Interpretation
# =============================================================================
# Provider: deepseek | ollama | openai
AI_SEARCH_PROVIDER=deepseek
# Base URL for the AI API (omit to use provider default)
# DeepSeek: https://api.deepseek.com/v1
# Ollama local: http://localhost:11434/v1
# OpenAI: https://api.openai.com/v1
AI_SEARCH_BASE_URL=https://api.deepseek.com/v1
# API key for the AI provider (omit for local ollama)
AI_SEARCH_API_KEY=
# Model name
AI_SEARCH_MODEL=deepseek-v4-flash
# Timeout for AI requests (Go duration format)
AI_SEARCH_TIMEOUT=30s

# =============================================================================
# AI OCR — Document Data Extraction (DeepSeek V4 Flash multimodal)
# =============================================================================
# Provider for OCR (currently only deepseek supported)
AI_OCR_PROVIDER=deepseek
# Base URL (defaults to https://api.deepseek.com/v1 if empty)
AI_OCR_BASE_URL=https://api.deepseek.com/v1
# API key (same provider can share key with search, or use separate)
AI_OCR_API_KEY=
# Model for OCR (multimodal required — must accept image_url inputs)
AI_OCR_MODEL=deepseek-chat
# Timeout for OCR requests (Go duration format, OCR can take longer)
AI_OCR_TIMEOUT=60s

# =============================================================================
# DOCUMENT UPLOAD LIMITS
# =============================================================================
DOCUMENT_MAX_SIZE_MB=20
IMAGE_MAX_SIZE_MB=10
DOCUMENT_MAX_PER_USER=5
DOCUMENT_UPLOAD_RATE_LIMIT=10
DOCUMENT_UPLOAD_RATE_WINDOW=60
# Medical encryption (ChaCha20-Poly1305) — 32 bytes
MEDICAL_ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2
AI_DISCOVERY_ENABLED=true

# =============================================================================
# R2 STORAGE (Cloudflare R2 — S3-compatible object storage)
# Required for: document uploads, avatar uploads, file downloads
# =============================================================================
# Your R2 endpoint from Cloudflare dashboard (format: https://<account_id>.r2.cloudflarestorage.com)
R2_ENDPOINT=
# R2 Access Key ID (from Cloudflare R2 → Manage API Tokens)
R2_ACCESS_KEY_ID=
# R2 Secret Access Key
R2_SECRET_ACCESS_KEY=
# R2 bucket name
R2_BUCKET_NAME=proactrip
# Use HTTPS (set to false only for local MinIO testing)
R2_USE_SSL=true
# R2 bucket names for specific use cases (overrides R2_BUCKET_NAME for targeted buckets)
R2_SECURE_BUCKET=proactrip-secure
R2_ASSETS_BUCKET=proactrip-assets
# SSE base URL for realtime events (leave default for dev)
SSE_BASE_URL=/v1/realtime/events