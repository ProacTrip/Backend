# Multi-stage Dockerfile for ProacTrip Backend MVP
# Optimized for PaaS deployment (Render/Railway)

# === Stage 1: Builder ===
FROM golang:1.26.1-alpine AS builder

ARG VERSION=dev
ARG BUILD_TIME=now

# Install build dependencies
RUN apk add --no-cache gcc musl-dev

WORKDIR /build

# Cache dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build optimized binary
RUN CGO_ENABLED=0 go build -buildvcs=false \
    -ldflags="-s -w -X main.version=${VERSION} -X main.buildTime=${BUILD_TIME}" \
    -o /app/api ./cmd/api

# === Stage 2: Runner ===
FROM alpine:3.23

# Security: create non-root user
RUN adduser -D -u 1000 appuser

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/api /app/api

# Copy .env.example as reference (user creates .env)
COPY --from=builder /build/.env.example /app/.env.example

# Use non-root user
USER appuser

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
    CMD wget -q --spider http://localhost:8080/health || exit 1

# Run the application
CMD ["/app/api"]
